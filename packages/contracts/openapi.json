{
  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "status": {
            "const": "accepted",
            "default": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Accepted",
        "type": "object"
      },
      "AppRole": {
        "enum": [
          "technician",
          "supervisor",
          "dept_admin",
          "data_steward",
          "platform_admin"
        ],
        "title": "AppRole",
        "type": "string"
      },
      "AuthEvent": {
        "properties": {
          "event": {
            "enum": [
              "sign_in_success",
              "sign_in_failure",
              "mfa_enroll",
              "mfa_unenroll",
              "mfa_challenge_failure",
              "sign_out",
              "sign_out_global",
              "idle_timeout",
              "session_expired"
            ],
            "title": "Event",
            "type": "string"
          }
        },
        "required": [
          "event"
        ],
        "title": "AuthEvent",
        "type": "object"
      },
      "Check": {
        "properties": {
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "ok"
        ],
        "title": "Check",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Invite": {
        "properties": {
          "accepted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "department_id": {
            "format": "uuid",
            "title": "Department Id",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          },
          "role": {
            "$ref": "#/components/schemas/AppRole"
          }
        },
        "required": [
          "id",
          "email",
          "department_id",
          "role",
          "created_at",
          "expires_at"
        ],
        "title": "Invite",
        "type": "object"
      },
      "InviteCreate": {
        "properties": {
          "department_id": {
            "format": "uuid",
            "title": "Department Id",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AppRole"
          }
        },
        "required": [
          "email",
          "department_id",
          "role"
        ],
        "title": "InviteCreate",
        "type": "object"
      },
      "Me": {
        "properties": {
          "aal": {
            "title": "Aal",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/Membership"
            },
            "title": "Memberships",
            "type": "array"
          },
          "theme": {
            "enum": [
              "system",
              "light",
              "dark"
            ],
            "title": "Theme",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "locale",
          "theme",
          "aal",
          "memberships"
        ],
        "title": "Me",
        "type": "object"
      },
      "Membership": {
        "properties": {
          "department_id": {
            "title": "Department Id",
            "type": "string"
          },
          "department_name": {
            "title": "Department Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "technician",
                "supervisor",
                "dept_admin",
                "data_steward",
                "platform_admin"
              ],
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "department_id",
          "department_name",
          "roles"
        ],
        "title": "Membership",
        "type": "object"
      },
      "Problem": {
        "description": "Problem Details (RFC 9457).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Ready": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Check"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Ready",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Decision support only. Academic prototype. No patient data.",
    "title": "SterileGuard AI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Problem"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "One or more checks failed"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Problem"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/admin/invites": {
      "post": {
        "operationId": "create_invite_v1_admin_invites_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invite"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Problem"
          }
        },
        "summary": "Create Invite",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/invites/{invite_id}/resend": {
      "post": {
        "operationId": "resend_invite_v1_admin_invites__invite_id__resend_post",
        "parameters": [
          {
            "in": "path",
            "name": "invite_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Invite Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invite"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Problem"
          }
        },
        "summary": "Resend Invite",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/admin/invites/{invite_id}/revoke": {
      "post": {
        "operationId": "revoke_invite_v1_admin_invites__invite_id__revoke_post",
        "parameters": [
          {
            "in": "path",
            "name": "invite_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Invite Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invite"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Problem"
          }
        },
        "summary": "Revoke Invite",
        "tags": [
          "admin"
        ]
      }
    },
    "/v1/audit/auth-event": {
      "post": {
        "operationId": "auth_event_v1_audit_auth_event_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Problem"
          }
        },
        "summary": "Auth Event",
        "tags": [
          "audit"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Problem"
          }
        },
        "summary": "Me",
        "tags": [
          "me"
        ]
      }
    }
  }
}
