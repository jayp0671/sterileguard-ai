# Copy to .env (gitignored). Never commit real values.
# Lines tagged "# optional" are not required by sg doctor.

# Supabase (local stack defaults come from `supabase status`; staging values from the dashboard)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY= # optional (scheduled jobs and invites only)
SUPABASE_DB_URL= # optional (direct Postgres for sg db migrate --env staging)

# Web (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # optional (Cloudflare Turnstile; test key in dev)

# API
CORS_ORIGINS=http://localhost:3000
INTERNAL_TOKEN=change-me-locally
ENV=local
MODEL_BUCKET=models # optional
NIM_API_KEY= # optional (NVIDIA NIM, SG-23)

# Deployed URLs read by sg memory sync
WEB_URL= # optional
API_URL= # optional
