# Copy to .env (gitignored). Never commit real values. Two blocks: LOCAL (the Docker Supabase stack) and
# STAGING (hosted project hhmrrvgvrjyrwvrrolzv). Local tools only read the unsuffixed names; `sg db ... --env
# staging` reads only the *_STAGING names.

# ---------- LOCAL (supabase start). Fill the keys from: pnpm exec supabase status -o env ----------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY= # optional
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development # optional: development | staging | production
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # optional

CORS_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000 # optional
INTERNAL_TOKEN=change-me-locally
ENV=local
MODEL_BUCKET=models # optional
NIM_API_KEY= # optional

# ---------- STAGING (hosted Supabase hhmrrvgvrjyrwvrrolzv) ----------
SUPABASE_PROJECT_REF_STAGING=hhmrrvgvrjyrwvrrolzv # optional
SUPABASE_URL_STAGING=https://hhmrrvgvrjyrwvrrolzv.supabase.co # optional
SUPABASE_ANON_KEY_STAGING= # optional
SUPABASE_JWKS_URL_STAGING=https://hhmrrvgvrjyrwvrrolzv.supabase.co/auth/v1/.well-known/jwks.json # optional
SUPABASE_SERVICE_ROLE_KEY_STAGING= # optional
# Session pooler (port 5432), password URL-encoded.
SUPABASE_DB_URL_STAGING=postgresql://postgres.hhmrrvgvrjyrwvrrolzv:<url-encoded-password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres # optional

# ---------- Deployed URLs (empty until deployed) ----------
WEB_URL= # optional
API_URL= # optional
